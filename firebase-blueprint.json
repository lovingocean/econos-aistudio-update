{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Commercial organization entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerUid": { "type": "string" },
        "tier": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerUid"]
    },
    "TreasuryAccount": {
      "title": "TreasuryAccount",
      "description": "Multi-currency treasury ledger bank account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "organizationId": { "type": "string" },
        "accountName": { "type": "string" },
        "currency": { "type": "string" },
        "currentBalanceUsd": { "type": "number" },
        "availableBalanceUsd": { "type": "number" }
      },
      "required": ["id", "organizationId", "accountName", "currency"]
    },
    "ScrapedLead": {
      "title": "ScrapedLead",
      "description": "Prospective B2B commercial lead discovered from Maps/Intelligence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" },
        "outreachStatus": { "type": "string" },
        "icpScore": { "type": "number" }
      },
      "required": ["id", "name", "location"]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Commercial organizations tenant collection"
    },
    "/organizations/{orgId}/treasuryAccounts/{accountId}": {
      "schema": "TreasuryAccount",
      "description": "Treasury accounts belonging to organization"
    },
    "/leads/{leadId}": {
      "schema": "ScrapedLead",
      "description": "Discovered commercial sales leads"
    }
  }
}
